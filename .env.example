# Copy to .env (gitignored) and fill in. Every setting the scripts read is
# listed here; nothing secret is ever hardcoded. The file is sourced by bash
# (scripts/planka/run.sh), so quote values that contain spaces or $.

# --- Planka bridge (scripts/planka/) --------------------------------------
# Base URL of your Planka instance, without /api.
PLANKA_URL=http://localhost:3000
# API key of the *bot* user (not your own account). Create it with
# POST /api/users/<bot user id>/api-key, see docs/planka-workflow.md.
PLANKA_API_KEY=
# Numeric id of the board to watch (it's in the board's URL).
PLANKA_BOARD_ID=
# Optional: URL prefix under which repo files are browsable (a markdown
# server, a GitHub blob URL ...). Replies then link files as LINK_BASE + path.
LINK_BASE=
# Optional: shell command run when a card comes back to you; the message
# is passed as $1. Keep the single quotes: this file is sourced by bash,
# and $1 must reach the command unexpanded. Example with Apprise:
#   NOTIFY_COMMAND='apprise -b "$1" "tgram://<bot token>/<chat id>"'
NOTIFY_COMMAND=
# Claude Code permission mode for headless runs. "auto" lets the agent act
# without prompts, gated by Claude Code's safety classifier; see SECURITY.md.
CLAUDE_PERMISSION_MODE=auto
# Headless runs need Claude Code credentials. Either be logged in with
# `claude` as the cron user, or set a token from `claude setup-token`:
CLAUDE_CODE_OAUTH_TOKEN=

# --- Semantic search (scripts/vector_index.py) ----------------------------
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=bge-m3
